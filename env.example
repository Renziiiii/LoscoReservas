# LoscoReservas — configuración de entorno (copiá a .env y completá)
# Prefijo obligatorio: LOSCO_  |  Ver README.md para el detalle de cada una.
# (Si preferís la convención .env.example: mv env.example .env.example)

# --- Base ---
LOSCO_DATABASE_PATH=data/reservas.db
LOSCO_TZ=America/Argentina/Buenos_Aires

# --- Auth (obligatorias en producción) ---
# Pares "usuario:contraseña" separados por coma
LOSCO_USERS=valen:cambiame
# Generá con: openssl rand -hex 32
LOSCO_JWT_SECRET=cambiame-por-un-secreto-largo
LOSCO_JWT_EXPIRE_MINUTES=480

# --- Mensajería vía Chatwoot (T5) ---
# Token de API de agente/admin de Chatwoot + account id (pedirselos a Valen)
LOSCO_CHATWOOT_BASE_URL=
LOSCO_CHATWOOT_API_TOKEN=
LOSCO_CHATWOOT_ACCOUNT_ID=0
# Nombres de las plantillas UTILITY y horarios de los jobs: SOLO valores
# iniciales del primer arranque — después se configuran en el panel
# (Dashboard → Ajustes), que además lista las plantillas directo de la API
# de Chatwoot y re-programa el scheduler al instante.
LOSCO_TEMPLATE_CONFIRMACION=reserva_confirmacion
LOSCO_TEMPLATE_INVITADOS=invitados_confirmacion
LOSCO_HORA_CONFIRMACION=09:00
LOSCO_HORA_INVITADOS=17:15
# Prender el scheduler solo cuando la mensajería esté lista de verdad
LOSCO_SCHEDULER_ENABLED=false

# --- Iframe en Chatwoot (T6, ver docs/iframe-chatwoot.md) ---
# Generá con: openssl rand -hex 24
LOSCO_IFRAME_KEY=
# Origen(es) de Chatwoot autorizados a embeber (separados por coma)
LOSCO_IFRAME_ORIGINS=*
